# FIFA Mispricing Tracker — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# The Odds API key (https://the-odds-api.com/)
# Required for fetching sportsbook odds.
ODDS_API_KEY=your_odds_api_key_here

# Optional: additional CORS origin (e.g., a Vercel preview URL)
# Leave unset in production.
# EXTRA_CORS_ORIGIN=https://fifa-frontend-git-main-yourname.vercel.app

# Development mode — set to true only for local dev with fake/mock data.
# Must be false in production.
DEV_MODE=false
